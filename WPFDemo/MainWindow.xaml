<Window x:Class="WPFDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFDemo"
        xmlns:windows="clr-namespace:WPFDemo.Windows"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Open Data Binding Window" Margin="5" Width="250" Height="35" Click="OpenDataBinding_Click"/>
            <Button Content="Open ListBox Window" Margin="5" Width="250" Height="35" Click="OpenListBox_Click"/>
        </StackPanel>
    </Grid>
</Window>